#!/usr/bin/env bash
# Pre-push gate. Fails the push if line coverage dropped or the
# baseline was bumped and not yet committed.
#
# Two parallel coverage ratchets:
#   - Android JVM:    coverage-baseline.txt        (run-jvm-tests.sh)
#   - archive-service: archive-service/coverage-baseline.txt
#                                                  (run-tests.sh)
#
# Wire up once per clone:
#   git config core.hooksPath scripts/git-hooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

step() { printf '\n\033[1;34m[pre-push]\033[0m %s\n' "$*"; }

step "Android JVM tests + coverage gate"
"$REPO_ROOT/scripts/run-jvm-tests.sh"
"$REPO_ROOT/scripts/check-coverage.sh"

step "JVM test-wiring drift guard"
# Fails if a pure-JVM *Test.kt is neither wired into run-jvm-tests.sh nor
# parked in jvm-test-skiplist.txt — so a new bare-JVM test can't silently
# skip the runner (the v0.1.84-dev FocusRewindTest omission). Membership
# of the bare-kotlinc island can't be globbed (transitive Android/Room
# deps), hence a guard rather than auto-discovery.
"$REPO_ROOT/scripts/check-jvm-test-wiring.sh"

step "App-wide coverage gate (Robolectric JaCoCo via Gradle)"
# Added v0.1.69 after the user surfaced that scripts/run-jvm-tests.sh
# only measures coverage of ~15 hand-picked pure-JVM files, missing
# entire packages (com.odyssey.nas, the Workers, the screens). This
# runs :app:jacocoDebugReport against the full Robolectric suite and
# ratchets against app-coverage-baseline.txt + app-coverage-floors.txt.
"$REPO_ROOT/scripts/check-app-coverage.sh"

step "Detekt (lint gate)"
# Belt-and-suspenders catch for SwallowedException + friends before
# the push lands. Tag-build CI runs detekt too (see
# .github/workflows/android.yml), so a fail-here means a fail-there;
# this just shaves the ~5min CI cycle off the feedback loop.
"$REPO_ROOT/scripts/run-detekt.sh"

step "archive-service pytest + coverage gate"
"$REPO_ROOT/archive-service/scripts/run-tests.sh"
"$REPO_ROOT/scripts/check-server-coverage.sh"
